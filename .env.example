# ==============================================================================
# Aman Visual — Production Environment Variables & Secrets
# ==============================================================================

# Application Base URL (used for payment return URLs, webhooks, and canonical links)
APP_URL="https://amanvisual.in"

# ------------------------------------------------------------------------------
# 1. CASHFREE PRODUCTION PAYMENT GATEWAY
# ------------------------------------------------------------------------------
# Get your production credentials from: https://merchant.cashfree.com
# Path: Cashfree Merchant Dashboard > Developers > API Keys (Production)
# CASHFREE_APP_ID: Your Cashfree Production App ID / Client ID
CASHFREE_APP_ID=
# CASHFREE_SECRET_KEY: Your Cashfree Production Secret Key (starts with cfsk_ma_prod_)
# Webhook signature verification uses this secret key with HMAC-SHA256
CASHFREE_SECRET_KEY=
# CASHFREE_MODE: Set to "production" for real money charges
CASHFREE_MODE=production
# CASHFREE_PAYMENT_LINK: Optional hosted payment form link
CASHFREE_PAYMENT_LINK=

# ------------------------------------------------------------------------------
# 2. TRANSACTIONAL EMAIL NOTIFICATIONS (CUSTOMER ENQUIRIES & BOOKINGS)
# ------------------------------------------------------------------------------
# DESTINATION_EMAIL: Studio inbox where all new customer enquiries and booking alerts are delivered
DESTINATION_EMAIL="amanproductionsteam@gmail.com"

# SMTP (Gmail App Password or custom SMTP server)
# To create a Gmail App Password: Google Account > Security > 2-Step Verification > App Passwords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="amanproductionsteam@gmail.com"
SMTP_PASS=
SENDER_EMAIL="Aman Visual <amanproductionsteam@gmail.com>"

# Alternative Email Provider: Resend API Key (if using Resend instead of SMTP)
RESEND_API_KEY=

# ------------------------------------------------------------------------------
# 3. OWNER STUDIO ADMIN PANEL
# ------------------------------------------------------------------------------
# ADMIN_PASSWORD: Secure PIN/password for the studio owner portal (/admin).
# Default fallback if unset is 8827474622.
ADMIN_PASSWORD=

# ------------------------------------------------------------------------------
# 4. SUPABASE DATABASE & ASSETS
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL="https://bzxwthyqoscvlplvguit.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_dyk4-slSVjCkJOgmtbqr6A_XLNAHEh6"

